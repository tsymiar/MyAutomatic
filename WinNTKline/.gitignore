## Ignore Visual Studio temporary files and build results

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.sln.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Xx]64/
[Xx]86/
[Bb]uild/
[Ll]inux/
[Bb]in/
[Oo]bj/
[Gg]en/
[Gg]eneratedFiles
[Tt]est[Rr]esult*/
.vs/

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db

# Compiled and intermediate files
*.obj
*.pch
*.pdb
*.ilk
*.tlb
*.tli
*.tlh
*.rsp
*.sbr
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
*.pidb
*.svclog
*.scc
*_i.c
*_p.c
*_i.h
dlldata.c

# Build logs
[Bb]uild[Ll]og.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Backup & upgrade reports
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# NuGet packages
**/packages/*
!**/packages/build/
*.nupkg

# Temporary and editor files
$tf/
.builds
~$*
*~
*.cache
!*.cache/
node_modules/

# Custom
WPF/
cache/
*.bin
*.conf
