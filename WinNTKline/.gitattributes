###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# Binary assets
#
# Declared after * text=auto so that they override it: line-ending conversion
# would corrupt these files. The LFS filter is set by the root .gitattributes.
###############################################################################
*.[Bb][Mm][Pp] -text
*.dll -text
*.[Ll][Ii][Bb] -text
*.pb -text
*.png -text
*.ttf -text
