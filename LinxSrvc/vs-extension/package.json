{
  "name": "similarity",
  "displayName": "Files Comparison",
  "description": "Compare two folders using Python",
  "version": "1.0.1",
  "publisher": "tsymiar",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "similarity.compareFolders",
        "title": "Compare Selected Directories"
      },
      {
        "command": "similarity.openResults",
        "title": "Open Files Comparison Results"
      },
      {
        "command": "similarity.quickCompare",
        "title": "Quick Compare Selected Folders"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "similarity.compareFolders",
          "when": "false"
        },
        {
          "command": "similarity.openResults",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "similarity.compareFolders",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "keybindings": [
      {
        "command": "similarity.quickCompare",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      }
    ],
    "configuration": {
      "title": "Files Comparison",
      "properties": {
        "similarity.ignoreExtensions": {
          "type": "string",
          "default": "",
          "description": "Comma-separated file extensions to skip. The compare command shows a checkbox picker and saves the checked extensions here."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "16.18.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.33.0",
    "typescript": "^4.9.5",
    "vsce": "^2.15.0",
    "vscode": "^1.1.37"
  },
  "repository": {}
}
