{
  "name": "similarity",
  "displayName": "Files Comparison",
  "description": "Compare two folders using Python",
  "version": "1.0.0",
  "publisher": "tsymiar",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "similarity.compareFolders",
        "title": "Compare Selected Directories"
      },
      {
        "command": "similarity.openResults",
        "title": "Open Files Comparison Results"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "similarity.compareFolders",
          "when": "false"
        },
        {
          "command": "similarity.openResults",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "similarity.compareFolders",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "16.18.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "eslint": "^8.33.0",
    "typescript": "^4.9.x",
    "vsce": "^2.15.0",
    "vscode": "^1.1.30"
  },
  "repository": {}
}
