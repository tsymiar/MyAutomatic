## Ignore patterns for build artifacts and temporary files

# Build output
**/build
**/dist
**/lcov
.build

# Compiled object files
bin
gen
out
kos

# Object and library files
*.o
*.a
*.so
*.so.*
*.d

# Kernel module artifacts
*.ko
*.mod*
[Mm]odule*.symvers
modules.order
.*.cmd

# Coverage
*.gcda
*.gcno
*.gcov
*.info

# Python
__pycache__
*.pyc
*.egg-info

# gen by gSOAPverify/soap/gen_client_fix.py
gSOAPverify/fix/soapClient_fix.cpp

# Visual Studio
.vs*
*.user
*.suo

# Temporary files
*.tmp*
*.log
.DS_Store
